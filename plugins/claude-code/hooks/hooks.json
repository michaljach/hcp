{
  "description": "HCP bridge. Every event POSTs to the plugin's MCP server, which Claude Code keeps alive for the session. PreToolUse is the permission channel: `type: \"http\"` hooks can return a permissionDecision, which `type: \"mcp_tool\"` hooks cannot.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7517/hook", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7517/hook", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7517/hook",
            "statusMessage": "Waiting for remote approval…",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7517/hook", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7517/hook", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7517/hook", "timeout": 5 } ] }
    ]
  }
}
